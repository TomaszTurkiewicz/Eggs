<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OtherGamesActivity"
    android:id="@+id/otherGames"
    android:background="@color/gray">

    <LinearLayout
        android:id="@+id/sendGameLinearlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <TextView
            android:id="@+id/sendGameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND THIS GAME TO FRIEND"
            android:textColor="@color/black"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/sendGameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/sendGameTvBlank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/battleShipsGameLinearlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/battleShipsGameTvBlankFront"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/battleShipsGameImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/battleShipsGameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATTLE SHIPS GAME"
            android:textColor="@color/black"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/battleShipsGameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/battleShipsGameTvBlank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </LinearLayout>


    <LinearLayout
        android:id="@+id/backToGameLinearLayoutOtherGames"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backToGameTvBlank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/backToGameOtherGames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/backToGameTextViewOtherGames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACK TO GAME"
            android:textColor="@color/black"
            android:gravity="center"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>